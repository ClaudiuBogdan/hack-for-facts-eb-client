# API URL for server connection
VITE_API_URL=http://localhost:3000

# PostHog (analytics) — only enabled when the user opts in via cookie consent
# VITE_POSTHOG_ENABLED=true
# VITE_POSTHOG_API_KEY=phc_your_public_project_api_key
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# VITE_POSTHOG_PERSON_PROFILES=identified_only

# Optional Discourse forum base URL for lesson discussion embeds
# VITE_DISCOURSE_BASE_URL=https://forum.example.com

# Optional comma-separated CC recipients for self-sent campaign emails
# VITE_CAMPAIGN_SELF_SEND_CC_EMAILS=contact@transparenta.eu,monitor@example.com

# Optional canonical site URL used by scripts to generate embed URLs
# VITE_SITE_URL=https://transparenta.eu

# Script-only Discourse topic provisioning credentials
# DISCOURSE_BASE_URL=https://forum.example.com
# DISCOURSE_API_KEY=your_discourse_api_key
# Must match the user authorized for the API key (usually admin/mod)
# DISCOURSE_API_USERNAME=your_discourse_username
# Optional thread language used for topic title/body sync and headers (en|ro)
# DISCOURSE_LANG=ro
# Optional: target category id for created topics.
# If omitted (or reserved), the script retries without category.
# DISCOURSE_CATEGORY_ID=1
