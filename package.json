{
  "name": "transparenta.eu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead",
    "iOS >= 16"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "dev:lint": "concurrently \"vite\" \"tsgo -w\" \"eslint ./src\"",
    "build": "tsgo -b && vite build && yarn i18n:compile",
    "build:app": "tsgo -b && vite build && yarn i18n:compile",
    "build:validate": "node scripts/validate-build-output.mjs",
    "sentry:prepare-artifacts": "node scripts/prepare-sentry-artifacts.mjs",
    "sentry:validate-debug-ids": "node scripts/validate-sentry-debug-ids.mjs /tmp/sentry-artifacts/assets",
    "start": "node .output/server/index.mjs",
    "stt": "node dist/server/server.js",
    "lint": "eslint . --max-warnings=0",
    "check": "yarn typecheck && yarn lint",
    "preview": "vite preview",
    "typecheck": "tsgo -b --noEmit",
    "learning:generate": "tsx scripts/generate-learning-paths.ts",
    "learning:validate": "tsx scripts/validate-learning-content.ts",
    "discourse:sync-topics": "node --import tsx scripts/sync-discourse-topics.ts",
    "challenge:validate": "tsx scripts/validate-challenge-content.ts",
    "discourse:sync-challenge-topics": "node --import tsx scripts/sync-challenge-discourse-topics.ts",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:integration": "playwright test --project=integration --workers=5",
    "test:integration:ui": "playwright test --project=integration --ui",
    "test:integration:debug": "playwright test --project=integration --debug",
    "test:e2e": "E2E_MODE=live playwright test --project=e2e",
    "test:e2e:ui": "E2E_MODE=live playwright test --project=e2e --ui",
    "test:e2e:snapshot": "E2E_MODE=replay playwright test --project=e2e",
    "test:e2e:snapshot:update": "E2E_MODE=record playwright test --project=e2e",
    "test:all": "playwright test",
    "router:generate": "node scripts/router-generate.mjs",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "i18n:clean": "lingui extract --clean",
    "worktree:create": "bash scripts/create-worktree.sh"
  },
  "scripts-info": {
    "i18n:extract": "Scan source files for Lingui message IDs and update locale catalogs (adds new keys, keeps obsolete ones).",
    "i18n:compile": "Compile translated catalogs into runtime assets (JS/JSON) that the app loads in production.",
    "i18n:clean": "Extract and remove obsolete/unused message IDs from catalogs to keep them tidy."
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.45",
    "@clerk/clerk-react": "^5.61.3",
    "@clerk/localizations": "^4.13.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
