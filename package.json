    "leaflet": "^1.9.4",
    "lucide-react": "^1.27.0",
    "maplibre-gl": "^6.0.0",
    "motion": "^12.43.0",
    "nitro": "^3.0.260610-beta",
    "papaparse": "^5.5.4",
