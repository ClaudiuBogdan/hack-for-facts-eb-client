{
  "name": "transparenta.eu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead",
    "iOS >= 16"
  ],
  "scripts": {
    "prepare": "husky",
    "postinstall": "HOME=$PWD yarn --cwd docs-site install --frozen-lockfile",
    "dev": "vite",
    "dev:lint": "concurrently \"vite\" \"tsgo -w\" \"eslint ./src\"",
    "build": "tsgo -b && vite build && yarn i18n:compile && yarn docs:build && node scripts/postbuild-docs.js",
    "build:app": "tsgo -b && vite build && yarn i18n:compile",
    "build:validate": "node scripts/validate-build-output.mjs",
    "sentry:prepare-artifacts": "node scripts/prepare-sentry-artifacts.mjs",
    "sentry:validate-debug-ids": "node scripts/validate-sentry-debug-ids.mjs /tmp/sentry-artifacts/assets",
    "start": "node .output/server/index.mjs",
    "stt": "node dist/server/server.js",
    "lint": "eslint . --max-warnings=0",
    "check": "yarn typecheck && yarn lint",
    "preview": "vite preview",
    "typecheck": "tsgo -b --noEmit",
    "learning:generate": "tsx scripts/generate-learning-paths.ts",
    "learning:validate": "tsx scripts/validate-learning-content.ts",
    "discourse:sync-topics": "node --import tsx scripts/sync-discourse-topics.ts",
    "challenge:validate": "tsx scripts/validate-challenge-content.ts",
    "discourse:sync-challenge-topics": "node --import tsx scripts/sync-challenge-discourse-topics.ts",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:integration": "playwright test --project=integration --workers=5",
    "test:integration:ui": "playwright test --project=integration --ui",
    "test:integration:debug": "playwright test --project=integration --debug",
    "test:e2e": "E2E_MODE=live playwright test --project=e2e",
    "test:e2e:ui": "E2E_MODE=live playwright test --project=e2e --ui",
    "test:e2e:snapshot": "E2E_MODE=replay playwright test --project=e2e",
    "test:e2e:snapshot:update": "E2E_MODE=record playwright test --project=e2e",
    "test:all": "playwright test",
    "router:generate": "node scripts/router-generate.mjs",
    "docs:start": "HOME=$PWD yarn --cwd docs-site start",
    "docs:build": "HOME=$PWD yarn --cwd docs-site install --frozen-lockfile && HOME=$PWD yarn --cwd docs-site build",
    "docs:serve": "HOME=$PWD yarn --cwd docs-site serve",
    "docs:clear": "HOME=$PWD yarn --cwd docs-site clear",
    "docs:swizzle": "HOME=$PWD yarn --cwd docs-site swizzle",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "i18n:clean": "lingui extract --clean"
  },
  "scripts-info": {
    "i18n:extract": "Scan source files for Lingui message IDs and update locale catalogs (adds new keys, keeps obsolete ones).",
    "i18n:compile": "Compile translated catalogs into runtime assets (JS/JSON) that the app loads in production.",
    "i18n:clean": "Extract and remove obsolete/unused message IDs from catalogs to keep them tidy."
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@clerk/localizations": "^4.5.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lingui/babel-plugin-lingui-macro": "^6.0.0",
    "@lingui/core": "^6.0.0",
    "@lingui/react": "^6.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/react": "^10.50.0",
    "@sentry/tanstackstart-react": "10.50.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.3",
    "@tanstack/react-router": "^1.169.1",
    "@tanstack/react-router-ssr-query": "^1.166.11",
    "@tanstack/react-start": "^1.167.62",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@turf/bbox": "^7.3.5",
    "@turf/center": "^7.3.5",
    "@visx/annotation": "^3.12.0",
    "@vitejs/plugin-react": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-sankey": "^0.12.3",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.2",
    "fflate": "^0.8.2",
    "file-saver": "^2.0.5",
    "fuse.js": "^7.3.0",
    "gray-matter": "^4.0.3",
    "html-to-image": "^1.11.13",
    "immer": "^11.1.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.11.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.38.0",
    "nitro": "^3.0.260311-beta",
    "papaparse": "^5.5.3",
    "pmtiles": "^4.4.1",
    "posthog-js": "^1.372.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.73.1",
    "react-hotkeys-hook": "^5.2.4",
    "react-intersection-observer": "^10.0.3",
    "react-is": "^19.2.5",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "satori": "^0.26.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@lingui/cli": "^6.0.0",
    "@lingui/vite-plugin": "^6.0.0",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.59.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sentry/cli": "^2.58.5",
    "@tanstack/router-plugin": "^1.167.32",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/d3-sankey": "^0.12.5",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
