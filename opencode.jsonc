{
  "$schema": "https://opencode.ai/config.json",

  // Project config belongs at the repo root. OpenCode merges this with
  // ~/.config/opencode/opencode.json and loads .opencode/{agents,commands,plugins}.
  "default_agent": "build",
  "share": "manual",
  "snapshot": true,

  "instructions": ["AGENTS.md", ".opencode/AGENTS.md"],

  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/.output/**",
      "**/.tanstack/**",
      "**/.vercel/**",
      "**/coverage/**",
      "**/playwright-report/**",
      "**/test-results/**",
      "**/tmp/**",
    ],
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000,
  },

  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      "**/*key*.pem": "deny",
    },
    "edit": {
      "*": "ask",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      "node_modules/**": "deny",
      "dist/**": "deny",
      ".output/**": "deny",
      "playwright-report/**": "deny",
      "test-results/**": "deny",
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "sed *": "allow",
      "cat *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "yarn typecheck": "allow",
      "yarn lint": "allow",
      "yarn test": "allow",
      "yarn test:*": "allow",
      "yarn build:app": "allow",
      "yarn build:validate": "allow",
      "yarn i18n:compile": "allow",
      "yarn i18n:extract": "ask",
      "yarn i18n:clean": "ask",
      "yarn add *": "ask",
      "yarn remove *": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git reset*": "deny",
      "rm *": "ask",
      "rm -rf *": "deny",
      "cat .env*": "deny",
      "head .env*": "deny",
      "tail .env*": "deny",
      "less .env*": "deny",
      "more .env*": "deny",
      "sed * .env*": "deny",
      "awk * .env*": "deny",
      "rg * .env*": "deny",
      "grep * .env*": "deny",
      "node * .env*": "deny",
      "python * .env*": "deny",
      "python3 * .env*": "deny",
      "cp .env*": "deny",
      "open .env*": "deny",
      "cat *key*.pem": "deny",
      "head *key*.pem": "deny",
      "tail *key*.pem": "deny",
    },
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "external_directory": {
      "*": "deny",
      "~/projects/**": "allow",
    },
  },

  "agent": {
    "build": {
      "description": "Default full-stack coding agent for this React/Vite frontend.",
      "mode": "primary",
      "prompt": "{file:.opencode/prompts/build.md}",
      "temperature": 0.2,
      "steps": 40,
      "color": "primary",
      "permission": {
        "edit": {
          "*": "allow",
          "**/.env": "deny",
          "**/.env.*": "deny",
          "**/.env.example": "allow",
          "**/*key*.pem": "deny",
          "node_modules/**": "deny",
          "dist/**": "deny",
          ".output/**": "deny",
          "playwright-report/**": "deny",
          "test-results/**": "deny",
        },
      },
    },
    "plan": {
      "description": "Read-only planning agent for discovery, risk analysis, and implementation plans.",
      "mode": "primary",
      "prompt": "{file:.opencode/prompts/plan.md}",
      "temperature": 0.1,
      "steps": 20,
      "color": "info",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "pwd": "allow",
          "ls *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "sed *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
        },
      },
    },
  },
}
